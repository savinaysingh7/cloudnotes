@startuml
title CloudNotes -- High-Level System Architecture
left to right direction
skinparam componentStyle rectangle
actor User
cloud "GitHub" as github
cloud "Docker Hub" as registry
node "AWS" {
  node "Jenkins EC2" { component "Jenkins CI/CD" as jenkins }
  node "Application EC2" {
    node "K3s Kubernetes Cluster" {
      component "NGINX Ingress" as ingress
      component "Frontend NGINX Pod(s)" as frontend
      component "Backend REST API Pod(s)" as backend
      database "PostgreSQL PVC" as postgres
      component "Prometheus" as prometheus
      component "KEDA" as keda
    }
  }
  folder "S3 Bucket" as s3
}
component "Grafana Live Dashboard" as grafana
User --> ingress : HTTP/HTTPS
ingress --> frontend
ingress --> backend : /api
frontend --> backend : REST requests
backend --> postgres : SQL
backend --> prometheus : /metrics
prometheus --> keda : request-rate query
prometheus --> grafana : metrics
github --> jenkins : push webhook
jenkins --> registry : push images
jenkins --> ingress : apply manifests / rollout
registry --> frontend : pull image
registry --> backend : pull image
@enduml
